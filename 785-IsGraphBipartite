1class Solution {
2public:
3    bool isBipartite(vector<vector<int>>& graph) {
4        int n = graph.size();
5        vector<int> seen(n, -1);
6
7        for (int i = 0; i < n; i++) {
8
9            if (seen[i] != -1)
10                continue;
11
12            queue<pair<int, int>> q;
13            q.push({i, 0});
14            seen[i] = 0;
15
16            while (!q.empty()) {
17
18                auto [node, color] = q.front();
19                q.pop();
20
21                int opp = (color == 0) ? 1 : 0;
22
23                for (int next : graph[node]) {
24
25                    if (seen[next] == -1) {
26                        seen[next] = opp;
27                        q.push({next, opp});
28                    }
29                    else if (seen[next] == color) {
30                        return false;
31                    }
32                }
33            }
34        }
35
36        return true;
37    }
38};